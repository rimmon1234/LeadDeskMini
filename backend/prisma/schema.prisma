generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id           String   @id @default(uuid())
  name         String
  email        String
  budget_range String
  source       String?
  message      String
  status       String   @default("NEW") // "NEW", "CONTACTED", "CLOSED"
  created_at   DateTime @default(now())
}

model User {
  id            String @id @default(uuid())
  email         String @unique
  password_hash String
}
